            passive_voices: [],
            choices: [
                DialogueChoice(
                    label: "Step back.",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        // ---------------- HOTSPOT: POKER TABLE ----------------
        DialogueNode(
            id: "inspect_table",
            speaker: "OVERTURNED TABLE",
            active_suspect_id: None,
            text: "Wedged under a table leg is Vance's ledger: '$400 — BADGE 419' beside a note on Danny Moreau's arrest.",
            grants_clues: ["clue_coded_payouts"],
            pulse_trigger: None,
            hunger_delta: 0.0,
            passive_voices: [],
            choices: [
                DialogueChoice(
                    label: "Breathe the cool draft to steady your thirst. [-Hunger]",
                    next_node: "table_steady_breath",
                ),
                DialogueChoice(
                    label: "Pocket the ledger.",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        DialogueNode(
            id: "table_steady_breath",
            speaker: "OVERTURNED TABLE",
            active_suspect_id: None,
            text: "The cold night air clears the crimson haze behind your eyes.",
            grants_clues: [],
            pulse_trigger: None,
            hunger_delta: -0.9,
            passive_voices: [],
            choices: [
                DialogueChoice(
                    label: "Done.",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        // ---------------- HOTSPOT: CURTAIN BLOOD ECHO ----------------
        DialogueNode(
            id: "inspect_curtain_echo",
            speaker: "VELVET CURTAIN",
            active_suspect_id: None,
            text: "Blood Sight reveals a pooled crimson stain scrubbed with bar gin. Vance was shot right here.",
            grants_clues: ["clue_curtain_kill_site"],
            pulse_trigger: None,
            hunger_delta: 0.1,
            passive_voices: [],
            choices: [
                DialogueChoice(
                    label: "Check the spatter angle on the wall.",
                    skill_check: Some(SkillCheckSpec(
                        id: "chk_curtain_geometry",
