CaseData(
    title: "THE GILDED VEIN",
    subtitle: "1:45 AM",
    opening_node: "boudoir_arrival",
    clues: [
        ClueDef(
            id: "ash_scorched_fangs",
            title: "Ash-Scorched Fangs & Courtroom Rouge",
            summary: "Judge Cross wore daytime mortal greasepaint and a wrist pulse-warmer—he was a closeted vampire seared internally the instant he swallowed.",
        ),
        ClueDef(
            id: "argyria_nailbeds",
            title: "Sabine's Silver-Blue Nailbeds",
            summary: "Acute bluish-silver argyria under mortal Sabine's nails and wormwood dregs prove her living bloodstream was dosed with chelated silver.",
        ),
        ClueDef(
            id: "pried_judicial_briefcase",
            title: "Missing Sun-Cell Warrant Stub",
            summary: "Cross's calfskin briefcase was unlocked with its brass key; the carbon stub for State v. Lucian Vespera remains, its signed original torn out.",
        ),
        ClueDef(
            id: "stolen_ward_contract",
            title: "Sabine's Stolen Wardship Bond",
            summary: "Sabine admits she took Cross's key as he choked only to reclaim her & her dead sister's Debt-Thrall contract—the warrant was already gone.",
        ),
        ClueDef(
            id: "dispensary_ledger",
            title: "1:15 AM Wormwood Tonic Entry",
            summary: "The salon ledger trades Cross's free visits for rigged Wardship rulings and logs Madame Vespera pouring Boudoir 4's wormwood draught at 1:15 AM.",
        ),
        ClueDef(
            id: "bailiff_car_manifest",
            title: "1:10 AM Private Salon Confrontation",
            summary: "Bailiff Corso's town-car log confirms Cross stopped alone with Vespera at 1:10 AM to wave her brother's Sun-Cell warrant before entering Boudoir 4.",
        ),
        ClueDef(
            id: "hidden_silver_ampoule",
            title: "40% Silver Ampoule & Charred Warrant",
            summary: "Stuffed behind the alley drainpipe: a crushed vial of chelated colloidal silver wrapped inside the half-burned Sun-Cell Extradition Order.",
        ),
        ClueDef(
            id: "silver_nitrate_stain",
            title: "Halide Burn Under Vespera's Glove",
            summary: "Beneath Madame Vespera's left black opera glove is an indelible violet-black silver-nitrate stain from snapping the concentrated ampoule.",
        ),
        ClueDef(
            id: "clue_apothecary_cypher",
            title: "Decoded Blotter: 'SILVER VIAL'",
            summary: "Madame Vespera's Atbash mirror-cipher blotter spells out 'SILVER VIAL' for Boudoir 4's 1:15 AM wormwood draught.",
        ),
    ],
    cyphers: [
        CypherDef(
            id: "cypher_vespera_formula",
            title: "Vespera's Alchemical Blotter",
            kind: Atbash,
            solution: "SILVER VIAL",
            flavor: "Pressed into the green ink-blotter on Madame Vespera's NE reception desk is a reversed apothecary formula.",
            hint: "Old-world Atbash mirror alphabet: A <-> Z, E <-> V, I <-> R, L <-> O, S <-> H.",
            solved_text: "Inverted in the mirror key, 'HROEVI ERZO' reads 'SILVER VIAL' — proving Boudoir 4's goblet was dosed at the salon desk! Your deductive edge sharpens (+2 to all 2d6 skill checks).",
            grants_clue: "clue_apothecary_cypher",
            roll_bonus: 2,
        ),
    ],
    nodes: [
        // ---------------- OPENING ARRIVAL ----------------
        DialogueNode(
            id: "boudoir_arrival",
            speaker: "SABINE MARLOWE",
            active_suspect_id: Some("sabine"),
            text: "\"Don't come any closer, {detective}—please! Judge Cross took one drink from my collarbone, coughed grey ash onto the rug, and dropped dead! Madame Vespera says my blood went bad!\"",
            grants_clues: [],
            pulse_trigger: Some(PulseTrigger(
                npc_id: "sabine",
                target_bpm: 98.0,
                is_lie_spike: false,
            )),
            hunger_delta: 0.0,
            passive_voices: [
                PassiveVoice(
                    faculty: None,
                    min_stat: 0,
                    requires_character: Some(Richey),
                    requires_blood_sight: false,
                    text: "Grey ash on a drinker's tongue while the mortal vessel still breathes? Something metallic stings the air. Press [Tab] to awaken {sense}.",
                ),
                PassiveVoice(
                    faculty: None,
                    min_stat: 0,
                    requires_character: Some(LuckerAndRon),
                    requires_blood_sight: false,
                    text: "Det. Lucker (Ghost): \"A Superior Court magistrate belly-up in a blood parlor! His shade is smoldering on that rug, Ron—hit [Tab] for Phantom Sight.\"",
                ),
                PassiveVoice(
                    faculty: None,
                    min_stat: 0,
                    requires_character: Some(Pinckney),
                    requires_blood_sight: false,
                    text: "Star-anise absinthe, burnt bone, and scorched metal—not natural rot. Press [Tab] to track with Lupine Scent.",
                ),
                PassiveVoice(
                    faculty: None,
                    min_stat: 0,
                    requires_character: Some(Zombie),
                    requires_blood_sight: false,
                    text: "Mortician's pancake makeup on a sitting judge's jaw, and eschar ash in his throat. Press [Tab] for Mortis Sight.",
                ),
            ],
            choices: [
                DialogueChoice(
                    label: "\"Breathe slow, Miss Marlowe. Nobody touches the body or that goblet until I look them over.\"",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        // ---------------- BOUDOIR 4: JUDGE CROSS CORPSE ----------------
        DialogueNode(
            id: "inspect_cross_corpse",
            speaker: "JUDGE HARLAN CROSS (CORPSE)",
            active_suspect_id: None,
            text: "Superior Court Judge Harlan Cross lies sprawled in bespoke pinstripe wool. Sweat-streaked courtroom greasepaint hides marble-pale skin and a battery pulse-warmer strapped to his wrist; his retracted fangs are blistered into silver-black ash.",
            grants_clues: ["ash_scorched_fangs"],
            pulse_trigger: None,
            hunger_delta: 0.0,
            passive_voices: [
                PassiveVoice(
                    faculty: Some(Deduction),
                    min_stat: 2,
                    requires_character: None,
                    requires_blood_sight: false,
                    text: "The hanging judge of the 14th Ward was a closeted vampire passing as mortal on the daytime bench.",
                ),
                PassiveVoice(
                    faculty: Some(Sanguine),
                    min_stat: 2,
                    requires_character: None,
                    requires_blood_sight: true,
                    text: "Under {sense}, scorched silver sparks cling to his lips and trail back toward the wormwood tray.",
                ),
            ],
            choices: [
                DialogueChoice(
                    label: "[Sanguine] Examine the blistered ash pattern inside his throat and vest pocket.",
                    next_node: "",
                    skill_check: Some(SkillCheckSpec(
                        id: "check_cross_throat",
                        faculty: Sanguine,
                        dc: 10,
                        hunger_cost: 0.4,
                        success_node: "cross_throat_success",
                        failure_node: "cross_throat_fail",
                    )),
                ),
                DialogueChoice(
                    label: "[Zombie Exclusive] Lay cold fingers on Cross's jaw and briefcase chain for a Mortis flash.",
                    next_node: "cross_zombie_psychometry",
                    requires_character: Some(Zombie),
                ),
                DialogueChoice(
                    label: "[Lucker & Ron Exclusive] Let Ghost Lucker interrogate the Judge's furious ash-shade.",
                    next_node: "cross_ghost_seance",
                    requires_character: Some(LuckerAndRon),
                ),
                DialogueChoice(
                    label: "Step back from the Judge's body.",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        DialogueNode(
            id: "cross_throat_success",
            speaker: "FORENSIC INSTINCT",
            active_suspect_id: None,
            text: "Not contact poison on his collar—chelated silver suspended in warm mortal blood seared his esophagus mid-swallow. Strangely, his silk vest pocket is turned slightly outward, its brass briefcase key missing.",
            grants_clues: ["ash_scorched_fangs"],
            pulse_trigger: None,
            hunger_delta: 0.0,
            passive_voices: [],
            choices: [
                DialogueChoice(
                    label: "Note the picked vest pocket and keep searching Boudoir 4.",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        DialogueNode(
            id: "cross_throat_fail",
            speaker: "FORENSIC INSTINCT",
            active_suspect_id: None,
            text: "Acrid silver-ash fumes bite at your {strain} before you can read the deeper tissue burn, though Cross's secret vampirism is unmistakable.",
            grants_clues: [],
            pulse_trigger: None,
            hunger_delta: 0.3,
            passive_voices: [],
            choices: [
                DialogueChoice(
                    label: "Clear your throat and inspect the rest of the suite.",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        DialogueNode(
            id: "cross_zombie_psychometry",
            speaker: "DET. GUINAN — MORTIS PSYCHOMETRY",
            active_suspect_id: None,
            text: "Two distinct post-mortem echoes: ten minutes earlier in the outer Salon, black velvet opera gloves sliding a signed warrant from his briefcase—then inside Boudoir 4, trembling bare fingers slipping his brass key from his vest as he fell.",
            grants_clues: ["ash_scorched_fangs"],
            pulse_trigger: Some(PulseTrigger(
                npc_id: "sabine",
                target_bpm: 124.0,
                is_lie_spike: true,
            )),
            hunger_delta: 0.4,
            passive_voices: [],
            choices: [
                DialogueChoice(
                    label: "Rise slowly and glance from Sabine's bare hands toward the outer Salon.",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        DialogueNode(
            id: "cross_ghost_seance",
            speaker: "ECHO IN RON'S EAR",
            active_suspect_id: None,
            text: "Det. Lucker: \"Whoa, grumpy magistrate! His shade keeps snarling one thing, Ron: 'Vespera smiled when I showed her Lucian's Sun-Cell order at the bar—she sent the girl in primed like a silver bullet!'\"",
            grants_clues: ["ash_scorched_fangs"],
            pulse_trigger: None,
            hunger_delta: 0.3,
            passive_voices: [],
            choices: [
                DialogueChoice(
                    label: "\"Quiet down, Lucker—now let's find physical proof that holds up in court.\"",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        // ---------------- BOUDOIR 4: WORMWOOD GOBLET & TRAY ----------------
        DialogueNode(
            id: "inspect_boudoir_goblet",
            speaker: "WORMWOOD GOBLET & TRAY",
            active_suspect_id: None,
            text: "A tarnished tray holds an empty crystal goblet crusted with milky emerald star-anise sugar—and a faint metallic mirror sheen along the rim. Across the rug, Sabine's fingernails show the same pale bluish-silver tint: acute argyria.",
            grants_clues: ["argyria_nailbeds"],
            pulse_trigger: None,
            hunger_delta: 0.0,
            passive_voices: [
                PassiveVoice(
                    faculty: Some(Deduction),
                    min_stat: 2,
                    requires_character: None,
                    requires_blood_sight: false,
                    text: "Chelated colloidal silver won't kill a mortal woman in one glass—it just turns her nailbeds slate-blue while turning her veins lethal to an undead drinker.",
                ),
            ],
            choices: [
                DialogueChoice(
                    label: "[Richey Exclusive] Draw a shallow breath over the crystal rim with Vampire Senses.",
                    next_node: "goblet_richey_fang_ache",
                    requires_character: Some(Richey),
                ),
                DialogueChoice(
                    label: "[Deduction] Reconstruct how the bitter metal taste was masked from the drinker.",
                    next_node: "",
                    skill_check: Some(SkillCheckSpec(
                        id: "check_goblet_chemistry",
                        faculty: Deduction,
                        dc: 9,
                        hunger_cost: 0.0,
                        success_node: "goblet_chemistry_success",
                        failure_node: "goblet_chemistry_fail",
                    )),
                ),
                DialogueChoice(
                    label: "Set the crystal goblet down.",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        DialogueNode(
            id: "goblet_richey_fang_ache",
            speaker: "DET. RICHEY — VAMPIRE INSTINCT",
            active_suspect_id: None,
            text: "Your upper canines throb white-hot at a single whiff. Forty-percent photographer's silver nitrate chelated in sweet wormwood syrup—mixed behind an apothecary bar by someone who knew Judge Cross wouldn't survive one mouthful.",
            grants_clues: ["argyria_nailbeds"],
            pulse_trigger: None,
            hunger_delta: 0.3,
            passive_voices: [],
            choices: [
                DialogueChoice(
                    label: "Steady your {strain} and check who poured Boudoir 4's drinks.",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        DialogueNode(
            id: "goblet_chemistry_success",
            speaker: "FORENSIC DEDUCTION",
            active_suspect_id: None,
            text: "Heavy star-anise and burnt sugar completely disguise metallic silver salts on a human tongue. Sabine could have drunk the whole glass believing it was a routine calming tonic.",
            grants_clues: ["argyria_nailbeds"],
            pulse_trigger: None,
            hunger_delta: 0.0,
            passive_voices: [],
            choices: [
                DialogueChoice(
                    label: "Log the wormwood goblet in the Crimson Ledger.",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        DialogueNode(
            id: "goblet_chemistry_fail",
            speaker: "FORENSIC DEDUCTION",
            active_suspect_id: None,
            text: "The licorice reek of wormwood overwhelms the subtler compound, though the silver residue on the glass is undeniable.",
            grants_clues: [],
            pulse_trigger: None,
            hunger_delta: 0.2,
            passive_voices: [],
            choices: [
                DialogueChoice(
                    label: "Check the Salon dispensary bar for the source bottle.",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        // ---------------- BOUDOIR 4: JUDICIAL BRIEFCASE ----------------
        DialogueNode(
            id: "inspect_judicial_briefcase",
            speaker: "CALFSKIN BRIEFCASE",
            active_suspect_id: None,
            text: "Monogrammed 'H. CROSS — SUPERIOR COURT.' The brass lock isn't jimmy-scratched—it was opened cleanly with a key. Inside sit 9:00 AM forfeiture notes on the 14th Ward clubs and a torn carbon stub: 'STATE v. LUCIAN VESPERA — SUN-CELL EXTRADITION.' The signed original is gone.",
            grants_clues: ["pried_judicial_briefcase"],
            pulse_trigger: None,
            hunger_delta: 0.0,
            passive_voices: [
                PassiveVoice(
                    faculty: Some(Pulse),
                    min_stat: 2,
                    requires_character: None,
                    requires_blood_sight: false,
                    text: "Across the rug, Sabine's breath catches the second your fingers touch that brass lock.",
                ),
            ],
            choices: [
                DialogueChoice(
                    label: "Close the flap and question Sabine or Madame Vespera about the missing warrant.",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        // ---------------- BOUDOIR 4: INTERROGATING SABINE MARLOWE ----------------
        DialogueNode(
            id: "talk_sabine_hub",
            speaker: "SABINE MARLOWE",
            active_suspect_id: Some("sabine"),
            text: "Sabine clutches her lace shawl over two fresh crimson punctures at her collarbone. \"He owned my contract, {detective}—just like he signed away my sister Celia's life last winter. I hated him, God help me, I did! But I didn't poison him!\"",
            grants_clues: [],
            pulse_trigger: Some(PulseTrigger(
                npc_id: "sabine",
                target_bpm: 92.0,
                is_lie_spike: false,
            )),
            hunger_delta: 0.0,
            passive_voices: [
                PassiveVoice(
                    faculty: Some(Pulse),
                    min_stat: 2,
                    requires_character: None,
                    requires_blood_sight: false,
                    text: "92 BPM—frightened, exhausted, yet completely steady when she denies poisoning him.",
                ),
            ],
            choices: [
                DialogueChoice(
                    label: "\"Look at your silver-blue nails, Sabine. Who poured that wormwood goblet before Cross came in?\"",
                    next_node: "sabine_tonic_truth",
                    requires_clue: Some("argyria_nailbeds"),
                ),
                DialogueChoice(
                    label: "\"Judge Cross's briefcase was unlocked with a key, Sabine—not forced. Did you open it?\"",
                    next_node: "sabine_briefcase_spike",
                    requires_clue: Some("pried_judicial_briefcase"),
                    hide_if_clue: Some("stolen_ward_contract"),
                ),
                DialogueChoice(
                    label: "\"Walk me through Cross's arrival again—did he come straight here from his town car?\"",
                    next_node: "sabine_timeline_note",
                ),
                DialogueChoice(
                    label: "[Accuse Sabine] \"You dosed your own veins to avenge your sister and robbed his briefcase. Hands behind your back.\"",
                    next_node: "ending_sabine_framed",
                    requires_clue: Some("argyria_nailbeds"),
                ),
                DialogueChoice(
                    label: "\"Stay on the divan, Sabine. Don't drink anything else tonight.\"",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        DialogueNode(
            id: "sabine_tonic_truth",
            speaker: "SABINE MARLOWE",
            active_suspect_id: Some("sabine"),
            text: "Sabine stares in horror at her slate-tinted fingertips. \"Madame Vespera brought that glass in herself at 1:15! She said Judge Cross was in a foul temper and doubled the sugar so I wouldn't flinch. She poisoned *me* to kill him?!\"",
            grants_clues: [],
            pulse_trigger: Some(PulseTrigger(
                npc_id: "sabine",
                target_bpm: 94.0,
                is_lie_spike: false,
            )),
            hunger_delta: 0.0,
            passive_voices: [
                PassiveVoice(
                    faculty: Some(Pulse),
                    min_stat: 2,
                    requires_character: None,
                    requires_blood_sight: false,
                    text: "Genuine shock—no deception spike. She had no idea silver was in that wormwood draught.",
                ),
            ],
            choices: [
                DialogueChoice(
                    label: "\"Let's talk about what else happened in this room.\"",
                    next_node: "talk_sabine_hub",
                ),
            ],
        ),

        DialogueNode(
            id: "sabine_timeline_note",
            speaker: "SABINE MARLOWE",
            active_suspect_id: Some("sabine"),
            text: "\"No! I heard his voice through the Salon curtain around ten past one—arguing low and vicious with Madame Vespera by the bar. Then she brought my green tonic, and he stepped in five minutes later wiping sweat off his makeup.\"",
            grants_clues: [],
            pulse_trigger: Some(PulseTrigger(
                npc_id: "sabine",
                target_bpm: 88.0,
                is_lie_spike: false,
            )),
            hunger_delta: 0.0,
            passive_voices: [],
            choices: [
                DialogueChoice(
                    label: "\"Back to the rest of your statement.\"",
                    next_node: "talk_sabine_hub",
                ),
            ],
        ),

        DialogueNode(
            id: "sabine_briefcase_spike",
            speaker: "SABINE MARLOWE",
            active_suspect_id: Some("sabine"),
            text: "Sabine's hand flies to her robe pocket. \"I—no! I never went near his leather bag! Why would I touch a judge's court papers while he was choking on the rug?!\"",
            grants_clues: [],
            pulse_trigger: Some(PulseTrigger(
                npc_id: "sabine",
                target_bpm: 138.0,
                is_lie_spike: true,
            )),
            hunger_delta: 0.0,
            passive_voices: [
                PassiveVoice(
                    faculty: Some(Pulse),
                    min_stat: 1,
                    requires_character: None,
                    requires_blood_sight: false,
                    text: "138 BPM LIE SPIKE! Her heart hammers like a trappedfinch—she's hiding what she took from that briefcase.",
                ),
            ],
            choices: [
                DialogueChoice(
                    label: "[Pulse] \"Your pulse just jumped off the chart, Sabine. Show me what's in your pocket—I'm hunting a killer, not a debtor.\"",
                    next_node: "",
                    skill_check: Some(SkillCheckSpec(
                        id: "check_sabine_contract",
                        faculty: Pulse,
                        dc: 10,
                        hunger_cost: 0.2,
                        success_node: "sabine_confesses_contract",
                        failure_node: "sabine_panics_contract",
                    )),
                ),
                DialogueChoice(
                    label: "[Deduction] \"Cross was a vampire killed by silver—not a stolen key. Give me the truth before Vespera pins the murder on you.\"",
                    next_node: "sabine_confesses_contract",
                    requires_clue: Some("ash_scorched_fangs"),
                ),
                DialogueChoice(
                    label: "\"Think carefully, Sabine. I'll come back to that briefcase.\"",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        DialogueNode(
            id: "sabine_panics_contract",
            speaker: "SABINE MARLOWE",
            active_suspect_id: Some("sabine"),
            text: "Tears spill down Sabine's cheeks as she clutches her silk pocket tighter, still terrified you'll haul her back to court—Wait: seeing your steady gaze, she finally pulls out a ribboned indenture sheet with shaking fingers.",
            grants_clues: ["stolen_ward_contract"],
            pulse_trigger: Some(PulseTrigger(
                npc_id: "sabine",
                target_bpm: 104.0,
                is_lie_spike: false,
            )),
            hunger_delta: 0.3,
            passive_voices: [],
            choices: [
                DialogueChoice(
                    label: "Read the indenture sheet and ask what was missing inside the briefcase.",
                    next_node: "sabine_confesses_contract",
                ),
            ],
        ),

        DialogueNode(
            id: "sabine_confesses_contract",
            speaker: "SABINE MARLOWE",
            active_suspect_id: Some("sabine"),
            text: "Sabine pulls a crumpled court bond from her robe: 'In re Wardship of Sabine & Celia Marlowe.' \"When he collapsed, I slipped his brass key off his vest just to take my freedom paper! I swear on Celia's grave, {detective}—that red-sealed Vespera extradition paper was *already torn out* when I opened the flap!\"",
            grants_clues: ["stolen_ward_contract"],
            pulse_trigger: Some(PulseTrigger(
                npc_id: "sabine",
                target_bpm: 84.0,
                is_lie_spike: false,
            )),
            hunger_delta: -0.2,
            passive_voices: [
                PassiveVoice(
                    faculty: Some(Deduction),
                    min_stat: 2,
                    requires_character: None,
                    requires_blood_sight: false,
                    text: "Her pulse settles to 84 BPM. Whoever ripped out Lucian Vespera's extradition order got into Cross's briefcase *before* he entered Boudoir 4.",
                ),
            ],
            choices: [
                DialogueChoice(
                    label: "\"Keep your sister's paper tucked away, Sabine. I'm paying Madame Vespera a visit.\"",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        // ---------------- SALON HOTSPOT: DISPENSARY LEDGER ----------------
        DialogueNode(
            id: "inspect_dispensary_ledger",
            speaker: "TONIC BAR & WARDSHIP LEDGER",
            active_suspect_id: None,
            text: "Bound in oxblood leather beside the absinthe fountain. One column pairs Judge Cross's 'Gratis Suite 4 Appointments' with rubber-stamped Debt-Thrall Wardships; the apothecary margin logs: '1:15 AM — Boudoir 4 Wormwood Calming Draught — Mixed personally by Mme. C. Vespera.'",
            grants_clues: ["dispensary_ledger"],
            pulse_trigger: None,
            hunger_delta: 0.0,
            passive_voices: [
                PassiveVoice(
                    faculty: Some(Sanguine),
                    min_stat: 2,
                    requires_character: None,
                    requires_blood_sight: true,
                    text: "Glowing droplets of spilled metallic tonic lead straight from behind this bar toward the East alley service door!",
                ),
            ],
            choices: [
                DialogueChoice(
                    label: "[Pinckney Exclusive] Flare Lupine Scent over the mahogany bar rail and trace the chemical spoor.",
                    next_node: "salon_pinckney_spoor",
                    requires_character: Some(Pinckney),
                ),
                DialogueChoice(
                    label: "Shut the ledger and follow the trail toward Madame Vespera or the East alley door.",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        DialogueNode(
            id: "salon_pinckney_spoor",
            speaker: "DET. PINCKNEY — LUPINE SPOOR",
            active_suspect_id: None,
            text: "Sharp ozone-silver nitrate, charred parchment smoke, and expensive French violet glove powder—tracked in hurried heel-clicks straight out the East service door into the rain.",
            grants_clues: ["dispensary_ledger"],
            pulse_trigger: None,
            hunger_delta: 0.3,
            passive_voices: [],
            choices: [
                DialogueChoice(
                    label: "Follow the violet-and-silver scent out to Red-Lantern Alley.",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        // ---------------- SALON: INTERROGATING MADAME COLETTE VESPERA ----------------
        DialogueNode(
            id: "talk_vespera_hub",
            speaker: "MADAME COLETTE VESPERA",
            active_suspect_id: Some("vespera"),
            text: "Madame Vespera stands poised in plum velvet and elbow-length black opera gloves, her pulse an ice-water 64 BPM. \"A tragic scandal, {detective}. Judge Cross ruled tomorrow on our 14th Ward competitors—losing him costs me a fortune. Clearly the Marlowe girl poisoned herself to spite him for her sister.\"",
            grants_clues: [],
            pulse_trigger: Some(PulseTrigger(
