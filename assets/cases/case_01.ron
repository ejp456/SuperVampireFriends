            id: "clue_vance_cypher",
            title: "Decoded Slip: 'LEFT HOLSTER'",
            summary: "Vance's Caesar-coded valise note warns that Badge 419 wears a left-hip .38 for their 1:30 AM curtain payoff.",
        ),
    ],
    cyphers: [
        CypherDef(
            id: "cypher_vance_valise",
            title: "Vance's Coded Valise Slip",
            kind: Caesar(shift: 3),
            solution: "LEFT HOLSTER",
            flavor: "Wedged inside the lining of Julian Vance's snapped calfskin valise in the SW corner is an encrypted insurance slip.",
            hint: "Beside Vance's three-diamond cufflink crest is penciled: 'Every letter stepped +3 forward (Cipher D -> Plain A).'",
            solved_text: "The shifted letters click into place: 'LEFT HOLSTER' — Vance recorded the exact southpaw draw of the crooked cop he met behind the velvet curtain! Your forensic instincts sharpen (+2 to all 2d6 skill checks).",
            grants_clue: "clue_vance_cypher",
            roll_bonus: 2,
        ),
    ],
    nodes: [
        DialogueNode(
            id: "intro_arrival",
            speaker: "SGT. FRANK MILLER",
            active_suspect_id: Some("miller"),
            text: "\"Stickup gone bad, {detective}. Sign the report so we can both get out of the rain before dawn.\"",
