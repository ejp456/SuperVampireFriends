        ),

        DialogueNode(
            id: "ending_clean_justice",
            speaker: "SGT. FRANK MILLER",
            active_suspect_id: Some("miller"),
            text: "You pin his wrist and take the .38 before he clears leather. By 4 AM, Internal Affairs has the gun, the ledger, and Miller in cuffs. [CASE CLOSED]",
            grants_clues: [],
            pulse_trigger: Some(PulseTrigger(
                npc_id: "miller",
                target_bpm: 96.0,
                is_lie_spike: false,
            )),
            hunger_delta: -0.5,
            passive_voices: [],
            choices: [
                DialogueChoice(
                    label: "Step back into the lounge.",
                    next_node: "LEAVE_CONVERSATION",
