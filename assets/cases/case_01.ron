                        dc: 10,
                        success_node: "ending_shadow_broker",
                        failure_node: "ending_clean_justice",
                        hunger_cost: 0.0,
                    )),
                ),
                DialogueChoice(
                    label: "Let your eyes catch the red neon and terrify a confession out of him.",
                    skill_check: Some(SkillCheckSpec(
                        id: "chk_miller_dread",
