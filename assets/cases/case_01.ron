                ),
                DialogueChoice(
                    label: "Step away.",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        DialogueNode(
            id: "curtain_geometry_ok",
            speaker: "VELVET CURTAIN",
            active_suspect_id: None,
            text: "Close-range .38 revolver — drawn and fired left-handed.",
            grants_clues: ["clue_left_handed_revolver"],
            pulse_trigger: None,
            hunger_delta: 0.0,
            passive_voices: [
