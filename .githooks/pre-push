#!/usr/bin/env sh
# Pre-push hook: ensures the latest main commit is deployed & verified on
# Google Cloud (streaming-friends-server) whenever pushing main to GitHub.
# (No-op in ~50ms if post-commit already deployed this commit SHA.)
set -e

BRANCH="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
if [ "$BRANCH" != "main" ] && [ "${FORCE_DEPLOY:-0}" != "1" ]; then
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
"$REPO_ROOT/scripts/deploy_and_verify.sh"
