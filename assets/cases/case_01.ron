CaseData(
    title: "THE VELVET ALIBI",
    subtitle: "2:14 AM",
    opening_node: "intro_arrival",
    clues: [
        ClueDef(
            id: "clue_staged_rug",
            title: "Too-Clean Rug",
            summary: "Almost no blood soaked into the rug under Vance's chest wound.",
        ),
        ClueDef(
            id: "clue_dragged_body",
            title: "Hidden Drag Trail",
            summary: "Supernatural sight shows heel smears leading from the north stage curtain.",
        ),
        ClueDef(
