        DialogueNode(
            id: "ending_shadow_broker",
            speaker: "SGT. FRANK MILLER",
            active_suspect_id: Some("miller"),
            text: "Miller swallows hard and takes his hand off his gun. \"Deal, Vale. The kid walks at 8 AM — and my files are yours.\" [CASE CLOSED]",
            grants_clues: [],
            pulse_trigger: Some(PulseTrigger(
                npc_id: "miller",
                target_bpm: 108.0,
