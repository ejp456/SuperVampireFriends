CaseData(
    title: "THE VELVET ALIBI",
    subtitle: "2:14 AM",
    opening_node: "intro_arrival",
    clues: [
        ClueDef(
            id: "clue_staged_rug",
            title: "Too-Clean Rug",
            summary: "Almost no blood soaked into the rug under Vance's chest wound.",
        ),
        ClueDef(
            id: "clue_dragged_body",
            title: "Crimson Drag Trail",
            summary: "Blood Sight shows heel smears leading from the north stage curtain.",
        ),
        ClueDef(
            id: "clue_perfume_and_brass",
            title: "Jasmine & Police Oil",
            summary: "Vance's collar smells of jasmine perfume and precinct gun oil.",
        ),
        ClueDef(
            id: "clue_curtain_kill_site",
            title: "Curtain Kill Site",
            summary: "A gin-scrubbed blood pool proves Vance was shot behind the curtain.",
        ),
        ClueDef(
            id: "clue_left_handed_revolver",
            title: "Left-Handed .38 Shot",
            summary: "Spatter angle shows a heavy .38 fired left-handed up close.",
        ),
        ClueDef(
            id: "clue_coded_payouts",
            title: "Ledger: BADGE 419",
            summary: "Vance paid hush money to 'BADGE 419' and held leverage over Clara's brother.",
        ),
        ClueDef(
            id: "clue_monogram_handkerchief",
            title: "'F.M.' Cloth & .38 Casing",
            summary: "A bloodied silk cloth ('F.M.') and .38 casing hidden in the alley dumpster.",
        ),
        ClueDef(
            id: "clue_clara_testimony",
            title: "Clara's Confession",
            summary: "Clara saw Sgt. Miller (Badge 419) shoot Vance behind the curtain.",
        ),
        ClueDef(
            id: "clue_prowl_car_log",
            title: "Cruiser #419 Patrol Log",
            summary: "Miller's dash clipboard logs Car 419 parked on Harbor St. 40 minutes before the 911 call.",
        ),
    ],
    nodes: [
        DialogueNode(
            id: "intro_arrival",
            speaker: "SGT. FRANK MILLER",
            active_suspect_id: Some("miller"),
            text: "\"Stickup gone bad, Vale. Sign the report so we can both get out of the rain before dawn.\"",
            grants_clues: [],
            pulse_trigger: Some(PulseTrigger(
                npc_id: "miller",
                target_bpm: 72.0,
                is_lie_spike: false,
            )),
            hunger_delta: 0.0,
            passive_voices: [
                PassiveVoice(
                    faculty: Some(Sanguine),
                    min_stat: 2,
                    requires_blood_sight: false,
                    text: "Fresh gin and scrubbed blood in the air. Press [Tab] to use Blood Sight.",
                ),
            ],
            choices: [
                DialogueChoice(
                    label: "\"Give me five minutes with the room first, Frank.\"",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        // ---------------- HOTSPOT: CORPSE ----------------
        DialogueNode(
            id: "inspect_corpse",
            speaker: "JULIAN VANCE (CORPSE)",
            active_suspect_id: None,
            text: "A single .38 hole through his vest. Oddly, there's barely a drop of blood on the rug beneath him.",
            grants_clues: ["clue_staged_rug"],
            pulse_trigger: None,
            hunger_delta: 0.0,
            passive_voices: [
                PassiveVoice(
                    faculty: Some(Deduction),
                    min_stat: 2,
                    requires_blood_sight: false,
                    text: "He bled out somewhere else and was moved here.",
                ),
            ],
            choices: [
                DialogueChoice(
                    label: "[Blood Sight] Trace the glowing red smears by his heels.",
                    next_node: "inspect_corpse_blood_sight",
                    requires_blood_sight: true,
                    hide_if_clue: Some("clue_dragged_body"),
                ),
                DialogueChoice(
                    label: "Check the scent on his collar.",
                    skill_check: Some(SkillCheckSpec(
                        id: "chk_corpse_scent",
                        faculty: Sanguine,
                        dc: 9,
                        success_node: "corpse_scent_ok",
                        failure_node: "corpse_scent_fail",
                        hunger_cost: 0.35,
                    )),
                ),
                DialogueChoice(
                    label: "Step back.",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        DialogueNode(
            id: "inspect_corpse_blood_sight",
            speaker: "JULIAN VANCE (CORPSE)",
            active_suspect_id: None,
            text: "Faint crimson heel-marks streak straight north toward the velvet stage curtain.",
            grants_clues: ["clue_dragged_body"],
            pulse_trigger: None,
            hunger_delta: 0.15,
            passive_voices: [],
            choices: [
                DialogueChoice(
                    label: "Follow the trail north.",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        DialogueNode(
            id: "corpse_scent_ok",
            speaker: "JULIAN VANCE (CORPSE)",
            active_suspect_id: None,
            text: "Two scents linger under the gunsmoke: Clara's jasmine perfume and precinct-issue gun oil.",
            grants_clues: ["clue_perfume_and_brass"],
            pulse_trigger: None,
            hunger_delta: 0.0,
            passive_voices: [],
            choices: [
                DialogueChoice(
                    label: "Step back.",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        DialogueNode(
            id: "corpse_scent_fail",
