        ),

        DialogueNode(
            id: "ending_crimson_verdict",
            speaker: "SGT. FRANK MILLER",
            active_suspect_id: Some("miller"),
            text: "\"God in heaven—your eyes...\" Miller stumbles back into the rain and scrawls a signed confession on his prowl car hood before you cuff him to the drainpipe. [CASE CLOSED]",
            grants_clues: [],
            pulse_trigger: Some(PulseTrigger(
                npc_id: "miller",
                target_bpm: 132.0,
