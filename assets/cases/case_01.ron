                    requires_blood_sight: false,
                    text: "The hood is stone cold. He was already inside when Vance died.",
                ),
            ],
            choices: [
                DialogueChoice(
                    label: "Step back from the cruiser.",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        // ---------------- NPC: CLARA MOREAU ----------------
        DialogueNode(
            id: "talk_clara",
            speaker: "CLARA MOREAU",
            active_suspect_id: Some("clara"),
            text: "\"I already told Sgt. Miller — I was out front singing when the gun went off.\"",
            grants_clues: [],
            pulse_trigger: Some(PulseTrigger(
                npc_id: "clara",
                target_bpm: 138.0,
                is_lie_spike: true,
