            hunger_delta: 0.0,
            passive_voices: [
                PassiveVoice(
                    faculty: Some(Pulse),
                    min_stat: 2,
                    requires_blood_sight: false,
                    text: "Her pulse just jumped to 138 BPM. She's lying.",
                ),
                PassiveVoice(
                    faculty: None,
                    min_stat: 3,
                    requires_blood_sight: false,
                    text: "138 BPM — her vein hammers warm under her pearls.",
                ),
            ],
            choices: [
                DialogueChoice(
                    label: "\"Your heart's racing, Clara. Who was really back here?\"",
                    skill_check: Some(SkillCheckSpec(
                        id: "chk_clara_pulse_press",
                        faculty: Pulse,
                        dc: 10,
                        success_node: "clara_confesses",
                        failure_node: "clara_guarded",
                        hunger_cost: 0.25,
                    )),
                ),
                DialogueChoice(
                    label: "\"Vance was killed behind your curtain and scrubbed with gin.\"",
                    next_node: "clara_confesses",
                    requires_clue: Some("clue_curtain_kill_site"),
                    hide_if_clue: Some("clue_clara_testimony"),
                ),
                DialogueChoice(
                    label: "\"Vance's ledger ties your brother to Badge 419. Talk to me.\"",
                    next_node: "clara_confesses",
                    requires_clue: Some("clue_coded_payouts"),
                    hide_if_clue: Some("clue_clara_testimony"),
                ),
                DialogueChoice(
                    label: "\"We'll talk in a minute.\"",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        DialogueNode(
            id: "clara_guarded",
            speaker: "CLARA MOREAU",
            active_suspect_id: Some("clara"),
            text: "\"Bring me real proof before asking me to cross a homicide sergeant, Mr. Vale.\"",
            grants_clues: [],
            pulse_trigger: Some(PulseTrigger(
                npc_id: "clara",
                target_bpm: 112.0,
                is_lie_spike: false,
            )),
            hunger_delta: 0.0,
            passive_voices: [],
            choices: [
                DialogueChoice(
                    label: "\"Fair enough.\"",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        DialogueNode(
            id: "clara_confesses",
            speaker: "CLARA MOREAU",
            active_suspect_id: Some("clara"),
            text: "\"Keep your voice down... Miller's Badge 419. He shot Julian behind the curtain with his left hand, threatened my brother, and tossed a cloth in the alley dumpster.\"",
            grants_clues: ["clue_clara_testimony"],
            pulse_trigger: Some(PulseTrigger(
                npc_id: "clara",
                target_bpm: 84.0,
                is_lie_spike: false,
            )),
            hunger_delta: 0.0,
            passive_voices: [],
            choices: [
                DialogueChoice(
                    label: "\"Stay behind the bar, Clara. I'll handle Miller.\"",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        // ---------------- NPC: SGT. FRANK MILLER ----------------
        DialogueNode(
            id: "talk_miller",
            speaker: "SGT. FRANK MILLER",
            active_suspect_id: Some("miller"),
            text: "\"Open-and-shut robbery, Vale. Vance flashed too much gold.\"",
            grants_clues: [],
            pulse_trigger: Some(PulseTrigger(
                npc_id: "miller",
                target_bpm: 72.0,
                is_lie_spike: false,
            )),
            hunger_delta: 0.0,
            passive_voices: [
                PassiveVoice(
                    faculty: Some(Deduction),
                    min_stat: 2,
                    requires_blood_sight: false,
                    text: "His tarnished shield reads 419 — and his holster sits on his left hip.",
                ),
            ],
            choices: [
                DialogueChoice(
                    label: "Hold up the bloodied 'F.M.' handkerchief and .38 casing.",
                    next_node: "miller_confrontation",
                    requires_clue: Some("clue_monogram_handkerchief"),
                ),
                DialogueChoice(
                    label: "\"Badge 419. Clara saw you shoot him behind the curtain, Frank.\"",
                    next_node: "miller_confrontation",
                    requires_clue: Some("clue_clara_testimony"),
                ),
                DialogueChoice(
                    label: "\"Left-handed .38 behind the curtain. Open your cylinder, Sergeant.\"",
                    next_node: "miller_confrontation",
                    requires_clue: Some("clue_left_handed_revolver"),
                ),
                DialogueChoice(
                    label: "\"Cruiser 419 was parked out front forty minutes before the 911 call, Frank.\"",
                    next_node: "miller_confrontation",
                    requires_clue: Some("clue_prowl_car_log"),
                ),
                DialogueChoice(
                    label: "\"Still looking around, Sergeant.\"",
                    next_node: "LEAVE_CONVERSATION",
                ),
            ],
        ),

        DialogueNode(
            id: "miller_confrontation",
            speaker: "SGT. FRANK MILLER",
            active_suspect_id: Some("miller"),
            text: "Miller's hand twitches toward his left holster. \"Careful, night-crawler — nobody misses a dead blackmailer.\"",
            grants_clues: [],
            pulse_trigger: Some(PulseTrigger(
                npc_id: "miller",
                target_bpm: 148.0,
                is_lie_spike: true,
            )),
            hunger_delta: 0.0,
            passive_voices: [
                PassiveVoice(
                    faculty: Some(Pulse),
                    min_stat: 1,
                    requires_blood_sight: false,
                    text: "148 BPM — he's about to draw or break.",
                ),
            ],
            choices: [
                DialogueChoice(
                    label: "Disarm him and call Internal Affairs.",
                    next_node: "ending_clean_justice",
                ),
                DialogueChoice(
                    label: "\"Drop Danny Moreau's charges — Badge 419 works for me now.\"",
                    skill_check: Some(SkillCheckSpec(
                        id: "chk_miller_blackmail",
